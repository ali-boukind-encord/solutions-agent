ANTHROPIC_API_KEY=sk-ant-your-key-here

# Encord auth - use ONE of these:
ENCORD_SSH_KEY_FILE=/path/to/your/encord_ed25519_private_key
# ENCORD_SSH_KEY_PATH=/path/to/your/encord_ed25519_private_key
# ENCORD_SSH_KEY=<raw key content>

# Optional: Encord domain (defaults to https://api.encord.com)
# ENCORD_DOMAIN=https://api.encord.com
